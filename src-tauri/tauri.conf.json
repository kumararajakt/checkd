{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "checkd",
  "version": "0.1.0",
  "identifier": "com.kumar.checkd",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "checkd",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGQzU5MzMwRDNGMzNEREYKUldUZlBmUFRNSlBGRDIxdVFoVTgyVXJsSGdYL1Rjc2VYbXg5R3FDYlcxdlJwY1VHZUFqYng3bEgK",
      "endpoints": [
        "https://github.com/kumararajakt/checkd/releases/latest/download/latest.json"
      ]
    }
  }
}
